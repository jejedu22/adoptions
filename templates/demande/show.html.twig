{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block title %}Demande {{ demande.numero }}{% endblock %}
{% block body %}
<p class="sub" style="margin:0 0 8px"><a href="{{ path('dossier_show', {id: demande.dossier.id}) }}">← {{ demande.dossier.libelle }}</a></p>
<div class="pagehead"><div><h1>Demande n° {{ demande.numero }} {{ m.badge(statut) }}</h1>
    <p class="sub">Dossier {{ demande.dossier.numero }}{% if demande.nature %} · {{ demande.nature }}{% endif %}{% if statut.prochaineEtape %} · <b>{{ statut.prochaineEtape }}</b>{% endif %}</p></div>
    <a class="btn" href="{{ path('demande_edit', {id: demande.id}) }}">Modifier la demande</a></div>
<div class="card">{{ m.frise(statut) }}</div>
<div class="grid g4" style="margin-top:14px">
    <div class="card"><h2>La demande</h2><dl>
        <dt>Date</dt><dd>{{ m.date(demande.dateDemande) }}</dd><dt>Type</dt><dd>{{ demande.type ?: '—' }}</dd>
        <dt>Enfants</dt><dd>{{ demande.nombreEnfants ?? '—' }}</dd><dt>Origine</dt><dd>{{ demande.origineEthnique ?: '—' }}</dd>
        <dt>Fratrie</dt><dd>{{ demande.fratrie ? 'Oui' : 'Non' }}</dd><dt>Ass. maternelle</dt><dd>{{ demande.assistanteMaternelle ? 'Oui' : 'Non' }}</dd>
        <dt>Sortie</dt><dd>{{ m.date(demande.dateSortie) }} {{ demande.motifSortie }}</dd><dt>Suspension</dt><dd>{{ m.date(demande.dateSuspension) }} {{ demande.motifSuspension }}</dd></dl></div>
    <div class="card"><h2>Agrément</h2><dl>
        <dt>Délivré le</dt><dd>{{ m.date(demande.dateAgrement) }}</dd>
        <dt>Origine</dt><dd>{% if demande.provenanceAgrement is null %}—{% elseif demande.provenanceAgrement == -2 %}Commission initiale{% elseif demande.provenanceAgrement == -1 %}Recours administratif{% else %}Recours contentieux{% endif %}</dd>
        <dt>Retrait</dt><dd>{{ m.date(demande.dateRetrait) }}</dd></dl>
        <form method="post" action="{{ path('demande_recalcul', {id: demande.id}) }}" style="margin-top:10px"><input type="hidden" name="_token" value="{{ csrf_token('recalcul' ~ demande.id) }}"><button class="btn s" type="submit">Recalculer l'agrément</button></form></div>
    <div class="card"><h2>Échéancier</h2><dl>{% for label, date in echeancier %}<dt>{{ label }}</dt><dd>{{ m.date(date) }}</dd>{% endfor %}</dl></div>
</div>
{% if demande.remarques %}<div class="card" style="margin-top:14px">{{ demande.remarques|nl2br }}</div>{% endif %}

<h2 style="margin-top:28px">Décisions et recours</h2>
<div class="card" style="padding:6px"><table class="list"><thead><tr><th>Origine</th><th>Commission</th><th>Signature</th><th>Dépôt</th><th>Décision</th><th></th></tr></thead><tbody>
    {% for x in demande.decisions %}<tr><td>{% if x.provenance == -2 %}Commission initiale{% elseif x.provenance == -1 %}Recours administratif{% else %}{{ x.typeRecours ?: 'Recours contentieux' }}{% endif %}</td>
        <td>{{ m.date(x.dateCommission) }}</td><td>{{ m.date(x.dateSignature) }}</td><td>{{ m.date(x.dateDepot) }}</td><td>{{ enum_label(x.deliberation) }}</td>
        <td class="right row-actions">{% include 'demande/_actions.html.twig' with {slug: 'decisions', id: x.id} %}</td></tr>
    {% else %}<tr><td colspan="6" class="empty">Aucune décision.</td></tr>{% endfor %}</tbody></table></div>
<p><a class="btn" href="{{ path('crud_new', {slug: 'decisions', parent: demande.id}) }}">+ Décision / recours</a></p>

<h2 style="margin-top:28px">Interventions (psychologues et travailleurs sociaux)</h2>
<div class="card" style="padding:6px"><table class="list"><thead><tr><th>Intervenant</th><th>Cadre</th><th>Demandé</th><th>Prévu</th><th>Reçu</th><th></th></tr></thead><tbody>
    {% for h in demande.historiques %}<tr><td>{{ h.intervenant }}</td><td>{{ enum_label(h.cadre, 'cadre') }}</td><td>{{ m.date(h.dateDemande) }}</td><td>{{ m.date(h.datePrevue) }}</td><td>{{ m.date(h.dateRecu) }}</td>
        <td class="right row-actions">{% if not h.dateRecu %}<form method="post" action="{{ path('intervention_recu', {id: h.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('recu' ~ h.id) }}"><button class="btn s" type="submit">Reçu aujourd'hui</button></form>{% endif %}
        {% include 'demande/_actions.html.twig' with {slug: 'historiques', id: h.id} %}</td></tr>
    {% else %}<tr><td colspan="6" class="empty">Aucune intervention.</td></tr>{% endfor %}</tbody></table></div>
<p><a class="btn" href="{{ path('crud_new', {slug: 'historiques', parent: demande.id}) }}">+ Intervention</a></p>

<h2 style="margin-top:28px">Enfants souhaités</h2>
<div class="card" style="padding:6px"><table class="list"><thead><tr><th>Sexe</th><th>Âge max</th><th>Handicap</th><th></th></tr></thead><tbody>
    {% for e in demande.enfants %}<tr><td>{{ enum_label(e.sexe, 'sexe') }}</td><td>{{ e.ageMax }}</td><td>{{ e.handicap ? 'Oui' : 'Non' }}</td><td class="right row-actions">{% include 'demande/_actions.html.twig' with {slug: 'enfants-demandes', id: e.id} %}</td></tr>
    {% else %}<tr><td colspan="4" class="empty">Aucun enfant souhaité.</td></tr>{% endfor %}</tbody></table></div>
<p><a class="btn" href="{{ path('crud_new', {slug: 'enfants-demandes', parent: demande.id}) }}">+ Enfant souhaité</a></p>

<h2 style="margin-top:28px">Placements</h2>
{% for p in demande.placements %}
<div class="card" style="margin-bottom:12px"><div class="pagehead"><div><b>{{ p.nomEnfant }} {{ p.prenomEnfant }}</b> <span class="muted">· placé le {{ m.date(p.datePlacement) }} · jugement {{ m.date(p.dateJugement) }}{% if p.oeuvre %} · {{ p.oeuvre }}{% endif %}</span></div>
    <div class="row-actions">{% include 'demande/_actions.html.twig' with {slug: 'placements', id: p.id} %}</div></div>
    <table class="list"><thead><tr><th>Surveillance prévue</th><th>Réalisée</th><th>Envoi TGI</th><th>Intervenant</th><th></th></tr></thead><tbody>
    {% for s in p.surveillances %}<tr><td>{{ m.date(s.datePrevue) }}</td><td>{{ m.date(s.dateRealisee) }}</td><td>{{ m.date(s.dateEnvoiTgi) }}</td><td>{{ s.intervenant ?: '—' }}</td><td class="right row-actions">{% include 'demande/_actions.html.twig' with {slug: 'surveillances', id: s.id} %}</td></tr>
    {% else %}<tr><td colspan="5" class="empty">Aucune surveillance.</td></tr>{% endfor %}</tbody></table>
    <p style="margin:12px 0 0"><a class="btn s" href="{{ path('crud_new', {slug: 'surveillances', parent: p.id}) }}">+ Surveillance</a></p></div>
{% else %}<p class="muted">Aucun placement.</p>{% endfor %}
<p><a class="btn" href="{{ path('crud_new', {slug: 'placements', parent: demande.id}) }}">+ Placement</a></p>
{% endblock %}
