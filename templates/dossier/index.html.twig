{% extends 'base.html.twig' %}
{% block title %}Dossiers{% endblock %}
{% block body %}
<h1>Dossiers d'adoption</h1>
<form method="get" class="actions">
    <input type="text" name="q" value="{{ q }}" placeholder="Numéro, nom, prénom ou ville" style="max-width:320px">
    <button class="btn sec" type="submit">Rechercher</button>
    <a class="btn" href="{{ path('dossier_new') }}">Nouveau dossier</a>
</form>
<table>
    <thead><tr><th>Numéro</th><th>Demandeur</th><th>Ville</th><th>Demandes</th></tr></thead>
    <tbody>
    {% for d in dossiers %}
        <tr>
            <td><a href="{{ path('dossier_show', {id: d.id}) }}">{{ d.numero }}</a></td>
            <td>{% for i in d.individus %}{{ i.nom }} {{ i.prenom }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
            <td>{{ d.ville }}</td>
            <td>{{ d.demandes|length }}</td>
        </tr>
    {% else %}
        <tr><td colspan="4" class="muted">Aucun dossier.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
