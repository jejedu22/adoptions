<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Adoptions{% endblock %} · Adoptions</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body>
{% set route = app.request.attributes.get('_route') ?? '' %}
<a class="skip" href="#contenu">Aller au contenu</a>
<div class="app">
<aside>
    <div class="logo">▣ Adoptions</div>
    <a class="nav {{ route == 'home' ? 'on' }}" href="{{ path('home') }}">🏠 Accueil</a>
    <a class="nav {{ route starts with 'dossier' or route starts with 'demande' ? 'on' }}" href="{{ path('dossier_index') }}">📁 Dossiers</a>
    {% set retards = nb_retards() %}
    <a class="nav {{ route == 'taches' ? 'on' }}" href="{{ path('taches') }}">✅ À traiter{% if retards %} <span class="badge b-bad">{{ retards }}</span>{% endif %}</a>
    <a class="nav {{ route == 'placements' ? 'on' }}" href="{{ path('placements') }}">👶 Placements</a>
    <a class="nav {{ route == 'commissions' ? 'on' }}" href="{{ path('commissions') }}">📅 Commissions</a>
    <div class="sep">Administration</div>
    <a class="nav {{ route == 'administration' or route starts with 'crud_' ? 'on' }}" href="{{ path('administration') }}">⚙️ Référentiels</a>
    <a class="nav" href="{{ path('crud_index', {slug: 'intervenants'}) }}">👥 Intervenants</a>
    <div class="user">{{ app.user ? app.user.userIdentifier : '' }}</div>
</aside>
<div>
    <div class="top">
        <form class="search" role="search" action="{{ path('recherche') }}" method="get">
            🔍 <input id="q" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher un dossier, une personne, un n° de demande…" aria-label="Recherche" autocomplete="off"><kbd>Ctrl K</kbd>
        </form>
        <a class="btn p" href="{{ path('dossier_new') }}">+ Nouveau dossier</a>
    </div>
    <main id="contenu">
        {% for type, messages in app.flashes %}{% for m in messages %}<div class="flash {{ type }}" role="status">{{ m }}</div>{% endfor %}{% endfor %}
        {% block body %}{% endblock %}
    </main>
</div>
</div>
<script src="{{ asset('js/app.js') }}" defer></script>
</body>
</html>
