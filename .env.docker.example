# Copier en .env.docker puis lancer : docker compose --env-file .env.docker up -d --build
# Nom de domaine servi par Traefik
APP_HOST=adoptions.example.org
# Réseau Docker partagé avec Traefik, point d'entrée HTTPS et résolveur de certificats (selon votre configuration Traefik)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
APP_SECRET=remplacez-par-une-chaine-aleatoire-de-32-caracteres
DB_PASSWORD=remplacez-moi
# Hash de « changeme » (à remplacer : php -r 'echo str_replace("$", "$$", password_hash("votre-mdp", PASSWORD_BCRYPT));')
APP_ADMIN_PASSWORD_HASH=$$2y$$10$$KBqa7rdFBBXg0mQXLMbK6OOw6at5w8zDko6r9LaCjSbM4a4oTrcX2
